# .env.example
# 실제 값을 채운 뒤 .env로 복사해서 쓴다 (.env는 .gitignore에 이미 포함되어 있음).

# --- docker-compose (Oracle DB 컨테이너, SYS/SYSTEM 비밀번호) ---
ORACLE_PASSWORD=OracleFree_2026!
ORACLE_PORT=1521

# --- 애플리케이션(src/tools.py)이 접속에 사용하는 값 ---
# db/init/01_setup_schema_and_data.sql에서 만드는 앱 스키마 계정과 반드시 일치해야 한다.
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_APP_USER=appuser
ORACLE_APP_PASSWORD=AppUser_2026!

# --- Langfuse 셀프호스팅 (docker-compose: langfuse-web/worker + postgres/clickhouse/redis/minio) ---
# 내부 인프라 시크릿 — 로컬 데모 전용, 운영 배포 시 반드시 교체할 것.
LANGFUSE_SALT=changeme_random_hex
LANGFUSE_ENCRYPTION_KEY=changeme_64_hex_chars  # openssl rand -hex 32 로 생성 (정확히 64자 필요)
LANGFUSE_NEXTAUTH_SECRET=changeme_random_hex
LANGFUSE_CLICKHOUSE_PASSWORD=changeme
LANGFUSE_REDIS_AUTH=changeme
LANGFUSE_MINIO_ROOT_PASSWORD=changeme

# LANGFUSE_INIT_* : langfuse-web 최초 기동 시 조직/프로젝트/관리자 계정/API 키를 자동 생성한다.
# (볼륨을 초기화하고 재기동하지 않는 한 이후 값을 바꿔도 반영되지 않는다.)
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-changeme
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=changeme

# --- 애플리케이션(src/tracing.py)이 Langfuse에 트레이스를 보낼 때 쓰는 값 ---
# 위 LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY와 반드시 동일해야 한다.
LANGFUSE_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_SECRET_KEY=sk-lf-changeme
LANGFUSE_HOST=http://localhost:3000

# --- LLM (기존) ---
# AWS_PROFILE=...
